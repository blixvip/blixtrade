[Unit]
Description=Encrypted Blix wallet and account recovery snapshot
After=blix-vault.service blix.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/node --no-warnings /opt/blix-live-vault/bin/backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/blix-wallets /opt/blix/data /var/lib/blix-vault/data

